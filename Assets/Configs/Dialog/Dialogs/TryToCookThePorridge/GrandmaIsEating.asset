%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d28bc3518bb02fa4eb483a2771e5e787, type: 3}
  m_Name: GrandmaIsEating
  m_EditorClassIdentifier: Assembly-CSharp::DialogConfig
  dialog:
  - person: {fileID: 11400000, guid: 3bcbfc24828f1bc40b34834c5dcff794, type: 2}
    message: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430, \u0432\u043E\u0442! \u0414\u043E\u0441\u0442\u0430\u043B
      \u0442\u043E\u043F\u043E\u0440, \u043A\u0430\u043A \u0442\u044B \u043F\u0440\u043E\u0441\u0438\u043B\u0430.
      \u0421\u0435\u0439\u0447\u0430\u0441 \u043A\u0430\u0448\u0443 \u0434\u043E\u0434\u0435\u043B\u0430\u044E."
  - person: {fileID: 11400000, guid: 031d6aed1ca1e6f4e85700b88e5a54d8, type: 2}
    message: "(\u0418\u0432\u0430\u043D \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442
      \u0442\u043E\u043F\u043E\u0440 \u0432 \u043A\u043E\u0442\u0435\u043B\u043E\u043A,
      \u043A\u0430\u0448\u0430 \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044F)"
  - person: {fileID: 11400000, guid: 3bcbfc24828f1bc40b34834c5dcff794, type: 2}
    message: "\u0413\u043E\u0442\u043E\u0432\u043E! \u0414\u0435\u0440\u0436\u0438,
      \u0431\u0430\u0431\u0443\u0448\u043A\u0430, \u0435\u0449\u0451 \u0433\u043E\u0440\u044F\u0447\u0430\u044F."
  - person: {fileID: 11400000, guid: ccce5614afe25b14d883d3942741986e, type: 2}
    message: "(\u0421\u043B\u0430\u0431\u043E \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F)"
  - person: {fileID: 11400000, guid: ccce5614afe25b14d883d3942741986e, type: 2}
    message: "\u041D\u0435\u0441\u0438, \u043D\u0435\u0441\u0438 \u0441\u043A\u043E\u0440\u0435\u0435,
      \u0412\u0430\u043D\u044E\u0448\u043A\u0430.\L"
  - person: {fileID: 11400000, guid: ccce5614afe25b14d883d3942741986e, type: 2}
    message: "(\u0418\u0432\u0430\u043D \u043A\u043E\u0440\u043C\u0438\u0442 \u0431\u0430\u0431\u0443\u0448\u043A\u0443
      \u0441 \u043B\u043E\u0436\u043A\u0438)"
  - person: {fileID: 11400000, guid: ccce5614afe25b14d883d3942741986e, type: 2}
    message: "\u041C\u043C\u043C... \u0434\u0430 \u043A\u0430\u043A \u0436\u0435
      \u0432\u043A\u0443\u0441\u043D\u043E... \u0422\u0435\u043F\u043B\u043E \u0442\u0430\u043A\u043E\u0435,
      \u0430\u0436 \u043D\u0430 \u0441\u0435\u0440\u0434\u0446\u0435 \u043B\u0435\u0433\u0447\u0435
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F."
  - person: {fileID: 11400000, guid: 3bcbfc24828f1bc40b34834c5dcff794, type: 2}
    message: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430, \u0442\u044B \u043A\u0430\u043A?
      \u041F\u043E\u043B\u0443\u0447\u0448\u0435?"
  - person: {fileID: 11400000, guid: ccce5614afe25b14d883d3942741986e, type: 2}
    message: "(\u0413\u043E\u043B\u043E\u0441 \u043A\u0440\u0435\u043F\u043D\u0435\u0442)"
  - person: {fileID: 11400000, guid: ccce5614afe25b14d883d3942741986e, type: 2}
    message: "\u041B\u0443\u0447\u0448\u0435, \u0412\u0430\u043D\u044E\u0448\u043A\u0430,
      \u0432\u043E\u0442 \u0435\u0439-\u0435\u0439, \u043B\u0443\u0447\u0448\u0435!
      \u0411\u0443\u0434\u0442\u043E \u0441\u0438\u043B\u0430 \u043F\u043E \u0436\u0438\u043B\u0430\u043C
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F."
  - person: {fileID: 11400000, guid: ccce5614afe25b14d883d3942741986e, type: 2}
    message: "(\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u0441\u0430\u0434\u0438\u0442\u0441\u044F,
      \u0431\u043E\u0434\u0440\u0430\u044F)"
  - person: {fileID: 11400000, guid: ccce5614afe25b14d883d3942741986e, type: 2}
    message: "\u041E\u0445, \u0434\u0430\u0439-\u043A\u0430 \u043E\u0431\u043D\u0438\u043C\u0443
      \u0442\u0435\u0431\u044F, \u0437\u043E\u043B\u043E\u0442\u0446\u0435 \u043C\u043E\u0451.
      \u041D\u0435 \u0437\u0440\u044F \u0442\u044B \u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u0442\u0440\u043E\u043F \u0438\u0441\u0445\u043E\u0434\u0438\u043B."
  - person: {fileID: 11400000, guid: 3bcbfc24828f1bc40b34834c5dcff794, type: 2}
    message: "\u042F \u0436\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B, \u0447\u0442\u043E
      \u0432\u0435\u0440\u043D\u0443\u0441\u044C!"
  - person: {fileID: 11400000, guid: ccce5614afe25b14d883d3942741986e, type: 2}
    message: "\u0412\u0435\u0440\u043D\u0443\u043B\u0441\u044F, \u0434\u0430 \u043D\u0435
      \u0441 \u043F\u0443\u0441\u0442\u044B\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438.
      \u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u0434\u043E\u0431\u044B\u0442\u0447\u0438\u043A
      \u0440\u0430\u0441\u0442\u0451\u0448\u044C, \u0412\u0430\u043D\u044E\u0448\u0430."
  - person: {fileID: 11400000, guid: ccce5614afe25b14d883d3942741986e, type: 2}
    message: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0442\u0435\u0431\u0435,
      \u0440\u043E\u0434\u043D\u043E\u0439. \u0415\u0441\u043B\u0438 \u0431\u044B
      \u043D\u0435 \u0442\u044B..."
  - person: {fileID: 11400000, guid: 3bcbfc24828f1bc40b34834c5dcff794, type: 2}
    message: "\u0422\u044B \u0436 \u043C\u043E\u044F \u0431\u0430\u0431\u0443\u0448\u043A\u0430.
      \u041A\u0430\u043A \u0436\u0435 \u0438\u043D\u0430\u0447\u0435?"
  - person: {fileID: 11400000, guid: 031d6aed1ca1e6f4e85700b88e5a54d8, type: 2}
    message: "(\u0417\u0430\u0442\u0435\u043C\u043D\u0435\u043D\u0438\u0435 \u044D\u043A\u0440\u0430\u043D\u0430
      \u2014 \u043A\u043E\u043D\u0435\u0446 \u0438\u0433\u0440\u044B)"
