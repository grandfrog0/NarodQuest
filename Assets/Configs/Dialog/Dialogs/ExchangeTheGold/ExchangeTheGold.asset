--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d28bc3518bb02fa4eb483a2771e5e787, type: 3}
  m_Name: ExchangeTheGold
  m_EditorClassIdentifier: Assembly-CSharp::DialogConfig
  dialog:
  - person: {fileID: 11400000, guid: 3bcbfc24828f1bc40b34834c5dcff794, type: 2}
    message: "\u0412\u043E\u0442, \u0434\u0435\u0440\u0436\u0438. \u0412\u0441\u0451
      \u0437\u043E\u043B\u043E\u0442\u043E, \u0447\u0442\u043E \u0431\u044B\u043B\u043E
      \u0432 \u043B\u043E\u0433\u043E\u0432\u0435."
  - person: {fileID: 11400000, guid: 6e602a9dcea4a6744929b145fff2e345, type: 2}
    message: "(\u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442,
      \u0431\u043E\u0440\u043C\u043E\u0447\u0430 \u043F\u043E\u0434 \u043D\u043E\u0441)"
  - person: {fileID: 11400000, guid: 6e602a9dcea4a6744929b145fff2e345, type: 2}
    message: "\u0422\u0430\u043A... \u0442\u0430\u043A... \u0412\u0440\u043E\u0434\u0435
      \u0432\u0441\u0451 \u0434\u043E \u043C\u043E\u043D\u0435\u0442\u043A\u0438."
  - person: {fileID: 11400000, guid: 3bcbfc24828f1bc40b34834c5dcff794, type: 2}
    message: "\u0422\u0435\u043F\u0435\u0440\u044C \u043F\u043B\u0430\u0449 \u043E\u0442\u0434\u0430\u0448\u044C,
      \u043A\u0430\u043A \u0443\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u043B\u0438\u0441\u044C?"
  - person: {fileID: 11400000, guid: 6e602a9dcea4a6744929b145fff2e345, type: 2}
    message: "\u0423\u0433\u043E\u0432\u043E\u0440 \u0434\u043E\u0440\u043E\u0436\u0435
      \u0437\u043E\u043B\u043E\u0442\u0430. \u0414\u0435\u0440\u0436\u0438, \u043D\u0435
      \u0436\u0430\u043B\u043A\u043E."
  - person: {fileID: 11400000, guid: 031d6aed1ca1e6f4e85700b88e5a54d8, type: 2}
    message: "(\u0418\u0433\u0440\u043E\u043A \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
      \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0439 \u043A\u043E\u0441\u0442\u044E\u043C)"
  - person: {fileID: 11400000, guid: 6e602a9dcea4a6744929b145fff2e345, type: 2}
    message: "\u041D\u0430\u0434\u0435\u043D\u0435\u0448\u044C \u2014 \u043D\u0438
      \u0448\u0438\u043F \u0442\u0435\u0431\u044F \u043D\u0435 \u0437\u0430\u0446\u0435\u043F\u0438\u0442,
      \u043D\u0438 \u043E\u0442\u0440\u0430\u0432\u0430 \u043D\u0435 \u0432\u043E\u0437\u044C\u043C\u0451\u0442.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0434\u043E\u043B\u0433\u043E \u043E\u043D
      \u0441\u0438\u043B\u0443 \u043D\u0435 \u0434\u0435\u0440\u0436\u0438\u0442,
      \u043D\u0435 \u043A\u043E\u043F\u0430\u0439\u0441\u044F \u0442\u0430\u043C."
  - person: {fileID: 11400000, guid: 3bcbfc24828f1bc40b34834c5dcff794, type: 2}
    message: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0442\u0435\u0431\u0435!
      \u041D\u0435 \u0437\u0430\u0431\u0443\u0434\u0443 \u0442\u0430\u043A\u043E\u0433\u043E."
  - person: {fileID: 11400000, guid: 6e602a9dcea4a6744929b145fff2e345, type: 2}
    message: "\u0418\u0434\u0438 \u0443\u0436\u0435, \u0438\u0434\u0438. \u041D\u0435\u0434\u043E\u0441\u0443\u0433
      \u043C\u043D\u0435 \u0441 \u0442\u043E\u0431\u043E\u0439 \u043B\u044F\u0441\u044B
      \u0442\u043E\u0447\u0438\u0442\u044C \u2014 \u0434\u0435\u043B \u043F\u043E
      \u0445\u043E\u0437\u044F\u0439\u0441\u0442\u0432\u0443 \u043F\u043E\u043B\u043D\u043E."
