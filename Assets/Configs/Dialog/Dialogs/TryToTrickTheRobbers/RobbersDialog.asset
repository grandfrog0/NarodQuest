--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d28bc3518bb02fa4eb483a2771e5e787, type: 3}
  m_Name: RobbersDialog
  m_EditorClassIdentifier: Assembly-CSharp::DialogConfig
  dialog:
  - person: {fileID: 11400000, guid: 3bcbfc24828f1bc40b34834c5dcff794, type: 2}
    message: "\u0422\u0438\u0445\u043E... \u0432\u0440\u043E\u0434\u0435 \u043D\u0438\u043A\u043E\u0433\u043E.
      \u041D\u0430\u0434\u043E \u0431\u044B \u043F\u043E-\u0431\u044B\u0441\u0442\u0440\u043E\u043C\u0443."
  - person: {fileID: 11400000, guid: 255dee34806d3254f9f9fc31f93f78b7, type: 2}
    message: "\u0422\u044B \u0433\u043B\u044F\u043D\u044C, \u043A\u0430\u043A\u0430\u044F
      \u043C\u044B\u0448\u044C \u043A \u043D\u0430\u043C \u0432 \u043D\u043E\u0440\u0443
      \u0437\u0430\u0431\u0440\u0430\u043B\u0430\u0441\u044C."
  - person: {fileID: 11400000, guid: 3bcbfc24828f1bc40b34834c5dcff794, type: 2}
    message: "\u042F... \u044F \u043D\u0435 \u0445\u043E\u0442\u0435\u043B \u043C\u0435\u0448\u0430\u0442\u044C.
      \u041C\u043D\u0435 \u0431\u044B \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u043E\u0439\u0442\u0438."
  - person: {fileID: 11400000, guid: caa6d4878be6858418c74e80904628af, type: 2}
    message: "\u041F\u0440\u043E\u0439\u0442\u0438? \u0422\u044B \u0432 \u043B\u043E\u0433\u043E\u0432\u043E
      \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u0447\u044C\u0435 \u0437\u0430\u0431\u0440\u0451\u043B,
      \u0430 \u043D\u0435 \u043D\u0430 \u044F\u0440\u043C\u0430\u0440\u043A\u0443
      \u043F\u0440\u043E\u0433\u0443\u043B\u0438\u0432\u0430\u0435\u0448\u044C\u0441\u044F."
  - person: {fileID: 11400000, guid: 3bcbfc24828f1bc40b34834c5dcff794, type: 2}
    message: "\u041F\u0440\u043E\u0441\u0442\u0438\u0442\u0435, \u044F \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u0432\u0437\u044F\u043B."
  - person: {fileID: 11400000, guid: 255dee34806d3254f9f9fc31f93f78b7, type: 2}
    message: "\u0410 \u0447\u0435\u0433\u043E \u0442\u043E\u0433\u0434\u0430 \u043A
      \u0441\u0443\u043D\u0434\u0443\u043A\u0430\u043C \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u043B\u0441\u044F,
      \u0430? \u041C\u044B \u0432\u0441\u0451 \u0432\u0438\u0434\u0435\u043B\u0438."
  - person: {fileID: 11400000, guid: 3bcbfc24828f1bc40b34834c5dcff794, type: 2}
    message: "\u041C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u043D\u0443\u0436\u043D\u043E
      \u0437\u043E\u043B\u043E\u0442\u043E. \u041D\u0435 \u0441\u0435\u0431\u0435
      \u2014 \u0431\u0430\u0431\u0443\u0448\u043A\u0435."
  - person: {fileID: 11400000, guid: caa6d4878be6858418c74e80904628af, type: 2}
    message: "\u0412\u0441\u0435 \u0443 \u043D\u0430\u0441 \u0442\u0443\u0442 \xAB\u043D\u0435
      \u0441\u0435\u0431\u0435\xBB. \u0418 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
      \u043A \u043D\u0430\u043C \u0432 \u044F\u043C\u0443 \u043E\u043D\u043E \u043F\u043E\u043F\u0430\u0434\u0430\u0435\u0442,
      \u0430 \u043D\u0435 \u043E\u0431\u0440\u0430\u0442\u043D\u043E."
  - person: {fileID: 11400000, guid: caa6d4878be6858418c74e80904628af, type: 2}
    message: "\u0412\u0437\u044F\u0442\u044C \u0435\u0433\u043E!"
  - person: {fileID: 11400000, guid: 3bcbfc24828f1bc40b34834c5dcff794, type: 2}
    message: "\u0421\u0442\u043E\u0439\u0442\u0435! \u042F \u0436\u0435 \u043F\u0440\u043E\u0441\u0442\u043E..."
