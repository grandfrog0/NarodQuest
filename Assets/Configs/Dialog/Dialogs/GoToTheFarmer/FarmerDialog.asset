%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d28bc3518bb02fa4eb483a2771e5e787, type: 3}
  m_Name: FarmerDialog
  m_EditorClassIdentifier: Assembly-CSharp::DialogConfig
  dialog:
  - person: {fileID: 11400000, guid: 3bcbfc24828f1bc40b34834c5dcff794, type: 2}
    message: "\u042D\u0439, \u0445\u043E\u0437\u044F\u0438\u043D! \u0415\u0441\u0442\u044C
      \u0442\u0443\u0442 \u043A\u0442\u043E?"
  - person: {fileID: 11400000, guid: 6e602a9dcea4a6744929b145fff2e345, type: 2}
    message: "\u041D\u0443? \u0427\u0435\u0433\u043E \u0441\u0442\u0443\u0447\u0438\u0448\u044C?"
  - person: {fileID: 11400000, guid: 3bcbfc24828f1bc40b34834c5dcff794, type: 2}
    message: "\u0417\u0434\u0440\u0430\u0432 \u0431\u0443\u0434\u044C! \u041C\u043D\u0435
      \u0431\u044B \u0441\u043A\u0432\u043E\u0437\u044C \u0441\u043E\u0440\u043D\u044F\u043A
      \u044D\u0442\u043E\u0442 \u043F\u0440\u043E\u0439\u0442\u0438 \u2013 \u0432\u043E\u043D
      \u0442\u0443\u0434\u0430, \u043A \u043C\u0443\u0440\u0430\u0432\u0435."
  - person: {fileID: 11400000, guid: 6e602a9dcea4a6744929b145fff2e345, type: 2}
    message: "\u0418 \u0437\u0430\u0447\u0435\u043C \u0442\u0435\u0431\u0435 \u0442\u0443\u0434\u0430?"
  - person: {fileID: 11400000, guid: 3bcbfc24828f1bc40b34834c5dcff794, type: 2}
    message: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u0445\u0432\u043E\u0440\u0430\u0435\u0442,
      \u0442\u0440\u0430\u0432\u0443 \u043F\u0440\u043E\u0441\u0438\u043B\u0430.
      \u041D\u0435 \u043F\u0440\u043E\u0439\u0442\u0438 \u043C\u043D\u0435 \u0432
      \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u0440\u0443\u0431\u0430\u0445\u0435."
  - person: {fileID: 11400000, guid: 6e602a9dcea4a6744929b145fff2e345, type: 2}
    message: "\u041D\u0435 \u043F\u0440\u043E\u0439\u0434\u0451\u0448\u044C, \u0442\u0443\u0442
      \u0442\u044B \u043F\u0440\u0430\u0432."
  - person: {fileID: 11400000, guid: 6e602a9dcea4a6744929b145fff2e345, type: 2}
    message: "\u0415\u0441\u0442\u044C \u0443 \u043C\u0435\u043D\u044F \u043A\u0440\u0430\u043F\u0438\u0432\u043D\u044B\u0439
      \u043F\u043B\u0430\u0449. \u041D\u0438\u043A\u0430\u043A\u0430\u044F \u043E\u0442\u0440\u0430\u0432\u0430
      \u043D\u0435 \u0432\u043E\u0437\u044C\u043C\u0451\u0442."
  - person: {fileID: 11400000, guid: 3bcbfc24828f1bc40b34834c5dcff794, type: 2}
    message: "\u0412\u043E\u0442 \u0441\u043F\u0430\u0441\u0438\u0431\u043E! \u0414\u0430\u0439,
      \u0432\u0435\u043A \u043F\u043E\u043C\u043D\u0438\u0442\u044C \u0431\u0443\u0434\u0443."
  - person: {fileID: 11400000, guid: 6e602a9dcea4a6744929b145fff2e345, type: 2}
    message: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0432 \u043A\u0430\u0440\u043C\u0430\u043D
      \u043D\u0435 \u043F\u043E\u043B\u043E\u0436\u0438\u0448\u044C. \u0417\u043E\u043B\u043E\u0442\u043E
      \u0434\u0430\u0432\u0430\u0439."
  - person: {fileID: 11400000, guid: 3bcbfc24828f1bc40b34834c5dcff794, type: 2}
    message: "\u0413\u0434\u0435 \u0436 \u044F \u0442\u0435\u0431\u0435 \u0437\u043E\u043B\u043E\u0442\u043E
      \u0432\u043E\u0437\u044C\u043C\u0443?"
  - person: {fileID: 11400000, guid: 6e602a9dcea4a6744929b145fff2e345, type: 2}
    message: "\u041B\u0430\u0434\u043D\u043E, \u043E\u043A\u0430\u0436\u0443 \u0443\u0441\u043B\u0443\u0433\u0443.
      \u0414\u0430\u043C \u0442\u0435\u0431\u0435 \u0441\u0435\u0439\u0447\u0430\u0441
      \u043A\u0430\u0440\u0442\u0443, \u043F\u043E \u043D\u0435\u0439 \u0438\u0434\u0435\u0448\u044C
      \u0434\u043E \u0442\u0430\u0439\u043D\u0438\u043A\u0430, \u0442\u0430\u043C
      \u0437\u043E\u043B\u043E\u0442\u043E \u043B\u0435\u0436\u0438\u0442."
  - person: {fileID: 11400000, guid: 3bcbfc24828f1bc40b34834c5dcff794, type: 2}
    message: "\u0427\u0442\u043E \u0437\u0430 \u0437\u043E\u043B\u043E\u0442\u043E?
      \u0422\u0432\u043E\u0451?"
  - person: {fileID: 11400000, guid: 6e602a9dcea4a6744929b145fff2e345, type: 2}
    message: "\u041D\u0435 \u0442\u0432\u043E\u0451 \u0434\u0435\u043B\u043E. \u041F\u0440\u0438\u043D\u0435\u0441\u0451\u0448\u044C
      \u0437\u043E\u043B\u043E\u0442\u043E \u2013 \u043F\u043E\u043B\u0443\u0447\u0438\u0448\u044C
      \u043F\u043B\u0430\u0449."
  - person: {fileID: 11400000, guid: 3bcbfc24828f1bc40b34834c5dcff794, type: 2}
    message: "\u041B\u0430\u0434\u043D\u043E. \u0414\u0430\u0432\u0430\u0439 \u0441\u0432\u043E\u044E
      \u043A\u0430\u0440\u0442\u0443."
  - person: {fileID: 11400000, guid: 6e602a9dcea4a6744929b145fff2e345, type: 2}
    message: "\u0414\u0435\u0440\u0436\u0438. \u0418 \u043D\u0435 \u0432\u0437\u0434\u0443\u043C\u0430\u0439
      \u043E\u0431\u043C\u0430\u043D\u0443\u0442\u044C \u2013 \u044F \u0432\u0441\u0451
      \u0432\u0438\u0436\u0443."
